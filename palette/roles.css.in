/* Shared desktop tokens; current Zen/Gecko aliases plus older role names. */
:root {
{{shared_tokens}}
  color-scheme: dark !important;
  --anto-accent: {{accent}} !important;
  --anto-foreground: {{foreground}} !important;
  --anto-muted: {{muted}} !important;
  --anto-selected-foreground: {{selected_fg}} !important;
  --anto-popover: {{popover}} !important;
  --zen-primary-color: var(--anto-accent) !important;
  --zen-accent-color: var(--anto-accent) !important;
  --zen-colors-primary: var(--anto-ui-surface) !important;
  --zen-colors-secondary: var(--anto-ui-surface-hover) !important;
  --zen-colors-tertiary: var(--anto-ui-panel) !important;
  --zen-colors-primary-foreground: var(--anto-foreground) !important;
  --zen-colors-input-bg: var(--anto-ui-surface) !important;
  --zen-colors-hover-bg: var(--anto-ui-surface-hover) !important;
  --zen-colors-border: var(--anto-ui-border) !important;
  --zen-colors-border-contrast: var(--anto-ui-border-glass) !important;
  --zen-branding-bg: {{background}} !important;
  --zen-branding-bg-reverse: var(--anto-foreground) !important;
  --zen-main-browser-background: var(--anto-ui-panel) !important;
  --zen-main-browser-background-toolbar: var(--anto-ui-panel) !important;
  --zen-main-browser-background-old: var(--anto-ui-panel) !important;
  --zen-main-browser-background-toolbar-old: var(--anto-ui-panel) !important;
  --zen-themed-toolbar-bg: transparent !important;
  --zen-themed-toolbar-bg-transparent: transparent !important;
  --zen-navigator-toolbox-background: transparent !important;
  --zen-toolbar-element-bg: var(--anto-ui-surface) !important;
  --zen-toolbar-element-bg-hover: var(--anto-ui-surface-hover) !important;
  --zen-dialog-background: var(--anto-popover) !important;
  --zen-sidebar-notification-bg: var(--anto-popover) !important;
  --zen-sidebar-notification-outline: 1px solid var(--anto-ui-border-glass) !important;
  --zen-in-content-dialog-background: var(--anto-popover) !important;
  --zen-urlbar-background: var(--anto-popover) !important;
  --zen-urlbar-background-base: var(--anto-popover) !important;
  --zen-urlbar-background-transparent: var(--anto-popover) !important;
  --zen-secondary-btn-color: var(--anto-foreground) !important;
  --zen-border-radius: var(--anto-radius-control) !important;
  --border-radius-small: var(--anto-radius-control) !important;
  --border-radius-medium: var(--anto-radius-control) !important;
  --border-radius-large: var(--anto-radius-card) !important;
  --panel-border-radius: var(--anto-radius-card) !important;
  --arrowpanel-menuitem-border-radius: var(--anto-radius-control) !important;
  --toolbarbutton-border-radius: var(--anto-radius-control) !important;
  --tab-border-radius: var(--anto-radius-control) !important;
  --button-border-radius: var(--anto-radius-control) !important;
  --input-border-radius: var(--anto-radius-control) !important;
  --color-accent-primary: var(--anto-accent) !important;
  --color-accent-primary-hover: var(--anto-accent) !important;
  --color-accent-primary-active: var(--anto-accent) !important;
  --color-accent-primary-selected: var(--anto-accent) !important;
  --color-accent-primary-contrast: var(--anto-selected-foreground) !important;
  --color-accent-primary-contrast-hover: var(--anto-selected-foreground) !important;
  --focus-outline-color: var(--anto-accent) !important;
  --text-color: var(--anto-foreground) !important;
  --text-color-deemphasized: var(--anto-muted) !important;
  --text-color-disabled: var(--anto-muted) !important;
  --background-color-box: var(--anto-ui-surface) !important;
  --background-color-canvas: var(--anto-ui-panel) !important;
  --background-color-selected: var(--anto-ui-surface-selected) !important;
  --border-color: var(--anto-ui-border) !important;
  --border-color-interactive: var(--anto-ui-border-glass) !important;
  --button-background-color: var(--anto-ui-surface) !important;
  --button-background-color-hover: var(--anto-ui-surface-hover) !important;
  --button-background-color-active: var(--anto-ui-surface-selected) !important;
  --button-background-color-primary: var(--anto-accent) !important;
  --button-background-color-primary-hover: var(--anto-accent) !important;
  --button-background-color-primary-active: var(--anto-accent) !important;
  --button-primary-hover-bgcolor: var(--anto-accent) !important;
  --button-primary-active-bgcolor: var(--anto-accent) !important;
  --button-primary-color: var(--anto-selected-foreground) !important;
  --button-text-color: var(--anto-foreground) !important;
  --button-text-color-primary: var(--anto-selected-foreground) !important;
  --input-background-color: var(--anto-ui-surface) !important;
  --input-color: var(--anto-foreground) !important;
  --input-border-color: var(--anto-ui-border-glass) !important;
  --input-placeholder-color: var(--anto-muted) !important;
  --input-text-background-color: var(--anto-ui-surface) !important;
  --input-text-color: var(--anto-foreground) !important;
  --input-text-border-color: var(--anto-ui-border-glass) !important;
  --input-text-border-radius: var(--anto-radius-control) !important;
  --toolbarbutton-icon-fill: currentColor !important;
  --toolbarbutton-icon-fill-attention: var(--anto-accent) !important;
  --toolbarbutton-background-color-hover: var(--anto-ui-surface-hover) !important;
  --toolbarbutton-background-color-active: var(--anto-ui-surface-selected) !important;
  --toolbar-bgcolor: transparent !important;
  --toolbar-background-color: transparent !important;
  --toolbar-color: var(--anto-foreground) !important;
  --toolbox-textcolor: var(--anto-foreground) !important;
  --toolbox-textcolor-inactive: var(--anto-foreground) !important;
  --lwt-text-color: var(--anto-foreground) !important;
  --lwt-sidebar-text-color: var(--anto-foreground) !important;
  --lwt-sidebar-background-color: transparent !important;
  --sidebar-text-color: var(--anto-foreground) !important;
  --sidebar-background-color: transparent !important;
  --toolbar-field-color: var(--anto-foreground) !important;
  --toolbar-field-focus-color: var(--anto-foreground) !important;
  --toolbar-field-background-color: var(--anto-ui-surface) !important;
  --toolbar-field-focus-background-color: var(--anto-ui-surface-hover) !important;
  --toolbar-field-border-color: var(--anto-ui-border-glass) !important;
  --toolbar-field-focus-border-color: var(--anto-accent) !important;
  --tab-selected-textcolor: var(--anto-foreground) !important;
  --tab-selected-bgcolor: var(--anto-ui-surface-selected) !important;
  --tab-background-color-selected: var(--anto-ui-surface-selected) !important;
  --tab-background-color-hover: var(--anto-ui-surface-hover) !important;
  --arrowpanel-background: var(--anto-popover) !important;
  --arrowpanel-color: var(--anto-foreground) !important;
  --arrowpanel-border-color: var(--anto-ui-border-glass) !important;
  --panel-background: var(--anto-popover) !important;
  --panel-background-color: var(--anto-popover) !important;
  --panel-color: var(--anto-foreground) !important;
  --panel-border-color: var(--anto-ui-border-glass) !important;
  --panel-separator-color: var(--anto-ui-border) !important;
  --panel-item-hover-bgcolor: var(--anto-ui-surface-hover) !important;
  --panel-item-active-bgcolor: var(--anto-ui-surface-selected) !important;
  --in-content-page-background: var(--anto-ui-panel) !important;
  --in-content-page-color: var(--anto-foreground) !important;
  --in-content-text-color: var(--anto-foreground) !important;
  --in-content-box-background: var(--anto-ui-surface) !important;
  --in-content-box-border-color: var(--anto-ui-border) !important;
  --in-content-primary-button-background: var(--anto-accent) !important;
  --in-content-primary-button-background-hover: var(--anto-accent) !important;
  --in-content-primary-button-background-active: var(--anto-accent) !important;
  --in-content-primary-button-text-color: var(--anto-selected-foreground) !important;
  --in-content-button-background: var(--anto-ui-surface) !important;
  --in-content-button-text-color: var(--anto-foreground) !important;
  --in-content-accent-color: var(--anto-accent) !important;
  --link-color: var(--anto-accent) !important;
  --link-color-hover: var(--anto-accent) !important;
  --link-color-active: var(--anto-accent) !important;
  --link-color-visited: {{purple}} !important;
  --newtab-background-color: transparent !important;
  --newtab-background-color-secondary: var(--anto-ui-surface) !important;
  --newtab-text-primary-color: var(--anto-foreground) !important;
  --newtab-text-secondary-color: var(--anto-muted) !important;
  --newtab-primary-action-background: var(--anto-accent) !important;
  --newtab-primary-action-color: var(--anto-selected-foreground) !important;
}
